# Required: openai or gemini
LLM_PROVIDER=openai

# Required when LLM_PROVIDER=openai
OPENAI_API_KEY=

# Required when LLM_PROVIDER=gemini
GEMINI_API_KEY=

# Camera
CAMERA_DEVICE_INDEX=0
CAMERA_URL=
CAMERA_HTTP_SNAPSHOT_PATH=/shot.jpg
CAPTURE_WIDTH=640
CAPTURE_HEIGHT=480

# Analysis
ANALYSIS_INTERVAL_SECONDS=5
OPENAI_MODEL=gpt-4o
GEMINI_MODEL=gemini-2.5-flash
